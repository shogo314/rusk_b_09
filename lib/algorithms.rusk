// Algorithms use the same generic extern and callback references as user code.
extern fn first_true<F>(left:Int,right:Int,predicate:F)->Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{Int}> left,Obj<@{Int}> right,Obj<@{F}> predicate,Loc loc){auto l=*left,r=*right;if(l>r)fail(loc,\"invalid binary search interval\");while(l<r){auto mid=static_cast<std::int64_t>(static_cast<__int128>(l)+(static_cast<__int128>(r)-l)/2);bool yes=*@{invoke F(Int)->Bool}(predicate,make_obj<@{Int}>(mid),loc);if(yes)r=mid;else l=mid+1;}return make_obj<@{Int}>(l);}",
}

extern fn all<S,F,I,T>(source:S,predicate:F)->Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{S}> source,Obj<@{F}> predicate,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);auto accepted=@{invoke F(T)->Bool}(predicate,value,loc);rusk_guard_iter(it,loc);if(*accepted==false)return make_obj<@{Bool}>(false);}return make_obj<@{Bool}>(true);}",
}

extern fn any<S,F,I,T>(source:S,predicate:F)->Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{S}> source,Obj<@{F}> predicate,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);auto accepted=@{invoke F(T)->Bool}(predicate,value,loc);rusk_guard_iter(it,loc);if(*accepted==true)return make_obj<@{Bool}>(true);}return make_obj<@{Bool}>(false);}",
}

extern fn to_vec<S,I,T>(source:S)->Vec<T> {
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{S}> source,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{ });while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);result->push_back(value);}return result;}",
}
extern fn fold<S,A,F,I,T>(source:S,seed:A,callback:F)->A {
    code: "@{return A} @{fn}(Obj<@{S}> source,Obj<@{A}> seed,Obj<@{F}> callback,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto accumulator=@{boxed_call copy(A)->A}(seed,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);accumulator=@{boxed_invoke F(A,T)->A}(callback,accumulator,value,loc);rusk_guard_iter(it,loc);}@{if_type A matches Unit}return;@{else}return accumulator;@{end}}",
}
extern fn scan<S,A,F,I,T>(source:S,seed:A,callback:F)->Vec<A> {
    code: "Obj<@{Vec<A>}> @{fn}(Obj<@{S}> source,Obj<@{A}> seed,Obj<@{F}> callback,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto result=make_obj<@{Vec<A>}>(@{Vec<A>}{ });auto accumulator=@{boxed_call copy(A)->A}(seed,loc);result->push_back(@{boxed_call copy(A)->A}(accumulator,loc));while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);accumulator=@{boxed_invoke F(A,T)->A}(callback,accumulator,value,loc);rusk_guard_iter(it,loc);result->push_back(@{boxed_call copy(A)->A}(accumulator,loc));}return result;}",
}

extern fn sort_by_comp<T,F>(source:Vec<T>,callback:F) {
    code: "void @{fn}(Obj<@{Vec<T>}> source,Obj<@{F}> callback,Loc loc){auto version=source->version;auto values=*source;std::stable_sort(values.begin(),values.end(),[&](const auto& a,const auto& b){if(source->version!=version)fail(loc,\"container changed during callback\");auto result=@{invoke F(T,T)->Bool}(callback,a,b,loc);if(source->version!=version)fail(loc,\"container changed during callback\");return *result;});source->assign(values.begin(),values.end());++source->version;}",
}

extern fn sort_by_key<T,F,K>(source:Vec<T>,callback:F) {
    code: "void @{fn}(Obj<@{Vec<T>}> source,Obj<@{F}> callback,Loc loc){auto version=source->version;constexpr bool may_change=@{writes_invoke F(T)->K}||@{writes copy(K)->K}||@{writes sequence_element_less(K,K)->Bool};std::vector<std::pair<Obj<@{K}>,Obj<@{T}>>> values;values.reserve(source->size());for(std::size_t i=0,n=source->size();i<n;++i){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}auto value=(*source)[i];auto key=@{invoke F(T)->K}(callback,value,loc);if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}auto detached=@{call copy(K)->K}(key,loc);if constexpr(@{writes copy(K)->K}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}values.push_back({std::move(detached),value});}if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}if constexpr(!may_change && !@{fails sequence_element_less(K,K)->Bool}){std::stable_sort(values.begin(),values.end(),[](const auto& a,const auto& b){return @{value_call sequence_element_less(K,K)->Bool}(a.first,b.first,Loc{});});}else{std::stable_sort(values.begin(),values.end(),[&](const auto& a,const auto& b){if constexpr(@{writes sequence_element_less(K,K)->Bool}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}auto result=@{value_call sequence_element_less(K,K)->Bool}(a.first,b.first,loc);if constexpr(@{writes sequence_element_less(K,K)->Bool}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}return result;});}for(std::size_t i=0;i<values.size();++i){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}(*source)[i]=values[i].second;}if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}++source->version;}",
}
