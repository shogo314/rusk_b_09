extern fn __div__(a: Int, b: Int) -> Int {
    lower: "rusk_div_int(*$0, *$1, $loc)",
    effects: "checked_read_fresh",
    cpp_name: "div_Int",
    code: "inline Obj<std::int64_t> div_Int(Obj<std::int64_t> a, Obj<std::int64_t> b, Loc loc) {\nif (*b == 0) fail(loc, \"division by zero\");\n    __int128 a0 = *a, b0 = *b;\n    __int128 q = a0 / b0, r = a0 % b0;\n    if (r != 0 && ((r < 0) != (b0 < 0))) { --q; r += b0; }\n    return make_obj<std::int64_t>(checked_int(q, loc));\n}",
}

